# ==============================================================================
# ENSALIA - Plantilla Sanitizada de Variables de Entorno (.env.example)
# Copie este archivo a ".env" para desarrollo local.
# NUNCA confirme ".env" ni "runtime.env" con rutas locales o credenciales reales.
# En produccion Windows, el lanzador inyecta las rutas dinamicamente via %LOCALAPPDATA%.
# ==============================================================================

# Base de datos SQLite local para desarrollo (ruta relativa al directorio prisma/ donde reside schema.prisma)
DATABASE_URL="file:./ensalia-dev.db?connection_limit=1&busy_timeout=5000"

# Codigo de acceso opcional para proteccion local
APP_ACCESS_CODE="cambiar-este-codigo-en-produccion"
ENSALIA_REQUIRE_ACCESS_CODE="false"

# Configuracion de ejecucion local exclusiva en loopback
NODE_ENV="development"
HOSTNAME="127.0.0.1"
PORT="3210"
